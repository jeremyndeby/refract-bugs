{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugs.getrefract.app/bugs.schema.json",
  "title": "Refract public bugs feed",
  "description": "Stable public contract produced by the private bug exporter and consumed by bugs.getrefract.app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "bugs"],
  "properties": {
    "schema_version": { "const": 5 },
    "generated_at": { "type": "string", "format": "date-time" },
    "bugs": { "type": "array", "items": { "$ref": "#/$defs/bug" } }
  },
  "$defs": {
    "publicText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?!.*(?:[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}|(?:token|secret|password|authorization)[=:][^\\s]+)).*$"
    },
    "authorKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "pattern": "^[A-Za-z][A-Za-z -]+$",
      "description": "Random, persistent pseudonym scoped to this post only; never derived reversibly from Discord identity."
    },
    "customEmoji": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^@\\r\\n]+$" },
        "id": { "type": "string", "pattern": "^[0-9]{17,20}$" }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emoji", "count"],
      "properties": {
        "emoji": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 32 },
            { "$ref": "#/$defs/customEmoji" }
          ]
        },
        "count": { "type": "integer", "minimum": 1 },
        "negative": { "type": "boolean" }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "date", "is_team", "author_key", "reactions"],
      "properties": {
        "text": { "$ref": "#/$defs/publicText" },
        "date": { "type": "string", "format": "date-time" },
        "is_team": { "type": "boolean" },
        "team_role": {
          "enum": ["dev", "mod", "team"],
          "description": "Present only on TEAM comments. Dev has precedence over Mod."
        },
        "author_key": { "$ref": "#/$defs/authorKey" },
        "team_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^@|\\r\\n]+$",
          "description": "Public display name for a current Discord Dev or Mod role member. Dev names are canonical by ID; Mod names are cleaned guild nicknames derived by ID."
        },
        "reactions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/reaction" } }
      },
      "allOf": [
        {
          "if": { "properties": { "is_team": { "const": false } }, "required": ["is_team"] },
          "then": {
            "allOf": [
              { "not": { "required": ["team_role"] } },
              { "not": { "required": ["team_name"] } }
            ]
          }
        },
        {
          "if": { "properties": { "is_team": { "const": true } }, "required": ["is_team"] },
          "then": { "required": ["team_role"] }
        },
        {
          "if": { "properties": { "team_role": { "enum": ["dev", "mod"] } }, "required": ["team_role"] },
          "then": { "required": ["team_name"] },
          "else": { "not": { "required": ["team_name"] } }
        }
      ]
    },
    "statusTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "tag": { "enum": ["🔍 Investigating", "🛠 In Progress"] },
        "applied_by": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^@\\r\\n]+$" },
        "applied_at": { "type": "string", "format": "date-time" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^\\./assets/bugs/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:avif|gif|jpe?g|png|webp)$" },
        "thumb": { "type": "string", "pattern": "^\\./assets/bugs/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:avif|gif|jpe?g|png|webp)$" }
      }
    },
    "bug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "body", "author_key", "posted_at", "status", "resolved_at", "tags", "status_tags",
        "reactors_unique", "score", "reactions", "comments_count", "activity_7d", "comments", "images"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{17,20}$" },
        "title": { "$ref": "#/$defs/publicText" },
        "body": { "$ref": "#/$defs/publicText" },
        "author_key": { "$ref": "#/$defs/authorKey" },
        "posted_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["open", "fixed", "duplicate", "off_topic"] },
        "resolved_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "tags": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^@\\r\\n]+$" }
        },
        "status_tags": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/statusTag" } },
        "reactors_unique": { "type": "integer", "minimum": 0 },
        "score": {
          "type": "number", "minimum": 0,
          "description": "Popularity score emitted by the shared /topbugs scoring module using the three TOPBUGS_* scoring parameters."
        },
        "reactions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/reaction" } },
        "comments_count": { "type": "integer", "minimum": 0 },
        "activity_7d": { "type": "integer", "minimum": 0 },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
        "images": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/image" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "open" } }, "required": ["status"] },
          "then": { "properties": { "resolved_at": { "type": "null" } } },
          "else": { "properties": { "resolved_at": { "type": "string", "format": "date-time" } } }
        }
      ]
    }
  }
}
